[Unit]
Description=bsc-geth v1.7.3 — BSC mainnet full node (snap sync, pruned PBSS)
Documentation=https://github.com/bnb-chain/bsc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/bsc-meme-mev/bsc-geth
ExecStart=/usr/local/bin/bsc-geth \
    --config /data/bsc-meme-mev/bsc-geth/conf/config.toml \
    --datadir /data/bsc-meme-mev/bsc-geth/data \
    --syncmode full \
    --pruneancient=true \
    --tries-verify-mode none \
    --history.transactions 0 \
    --history.logs 576000 \
    --cache 16384 \
    --maxpeers 80 \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 8545 \
    --http.api eth,net,web3,debug,txpool \
    --ws \
    --ws.addr 127.0.0.1 \
    --ws.port 8546 \
    --ws.api eth,net,web3,debug,txpool \
    --ipcpath /data/bsc-meme-mev/bsc-geth/geth.ipc \
    --metrics \
    --metrics.addr 127.0.0.1 \
    --metrics.port 6060

# Tuning notes (all per BSC docs § Node Maintenance, recommended pruneancient cmd):
#  --syncmode full + --pruneancient=true → REQUIRED when starting from the
#                  bnb-chain pruneancient PBSS snapshot. Snap-sync would
#                  attempt to re-download state from peers (overwriting the
#                  snapshot); full sync just replays new blocks forward.
#                  --pruneancient tells geth the freezer is intentionally
#                  pruned (without it: "ancient chain segments already
#                  extracted" fatal at startup).
#                  ONE-WAY: once on, ancient stays pruned; can't go back.
#  --tries-verify-mode none → "fastnode" mode; trusts snapshot state without
#                  re-verifying every trie root on import. Major speedup for
#                  the 5-week catch-up. Safe for RPC/mempool nodes; do NOT
#                  use on a validator. ONE-WAY: trie verification data lost.
#  --history.transactions 0 → don't index historical tx for getTxByHash.
#                  Saves CPU/disk during catch-up; the mempool watcher only
#                  reads pending txs anyway. Reversible.
#  --history.logs 576000 → keep ~3 days of log history (default v1.7.3, set
#                  explicitly to match docs).
#  --cache 16384 → 16 GB cache. 125 GB RAM box; plenty for OS + bsc-runner.
#  --maxpeers 80 → more peers = faster block fetch.
#  --state.scheme intentionally NOT set on CLI — snapshot's PBSS preserved.

Restart=on-failure
RestartSec=10
LimitNOFILE=1048576
TimeoutStopSec=300
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
