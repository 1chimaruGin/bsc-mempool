[Unit]
Description=bsc-geth v1.7.3 — BSC mainnet full node (snap sync, pruned PBSS)
Documentation=https://github.com/bnb-chain/bsc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/bsc-meme-mev/bsc-geth
ExecStart=/usr/local/bin/bsc-geth \
    --config /data/bsc-meme-mev/bsc-geth/conf/config.toml \
    --datadir /data/bsc-meme-mev/bsc-geth/data \
    --syncmode snap \
    --cache 16384 \
    --maxpeers 80 \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 8545 \
    --http.api eth,net,web3,debug,txpool \
    --ws \
    --ws.addr 127.0.0.1 \
    --ws.port 8546 \
    --ws.api eth,net,web3,debug,txpool \
    --ipcpath /data/bsc-meme-mev/bsc-geth/geth.ipc \
    --metrics \
    --metrics.addr 127.0.0.1 \
    --metrics.port 6060

# Tuning notes:
#  --cache 16384 → 16 GB cache. Box has 125 GB RAM total; plenty for OS +
#                  future bsc-runner. Speeds up snap sync state replay.
#  --maxpeers 80 → was 50; more peers = more state shards in parallel
#                  during snap sync. BSC has plenty of peers post-Fermi.
#  --state.scheme intentionally NOT set on CLI — let it inherit from
#                  whatever `bsc-geth init` wrote (default is PBSS on v1.7.3).
#  --diffsync REMOVED — legacy / pre-PBSS optimization; PBSS supersedes.
#  --tries-verify-mode REMOVED — default behavior is correct for snap sync.

Restart=on-failure
RestartSec=10
LimitNOFILE=1048576
TimeoutStopSec=300
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
