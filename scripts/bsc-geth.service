[Unit]
Description=bsc-geth — BSC mainnet full node (pruned)
Documentation=https://github.com/bnb-chain/bsc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/bsc-meme-mev/bsc-geth
ExecStart=/usr/local/bin/bsc-geth \
    --config /data/bsc-meme-mev/bsc-geth/conf/config.toml \
    --datadir /data/bsc-meme-mev/bsc-geth/data \
    --syncmode snap \
    --tries-verify-mode none \
    --diffsync \
    --cache 4096 \
    --rpc.allow-unprotected-txs \
    --txlookuplimit 0 \
    --http \
    --http.addr 127.0.0.1 \
    --http.port 8545 \
    --http.api eth,net,web3,debug,txpool \
    --ws \
    --ws.addr 127.0.0.1 \
    --ws.port 8546 \
    --ws.api eth,net,web3,debug,txpool \
    --ipcpath /data/bsc-meme-mev/bsc-geth/geth.ipc \
    --maxpeers 50 \
    --metrics \
    --metrics.expensive
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
